# GEMINI_API_KEY: Clave de Gemini AI (se usa exclusivamente en el servidor).
GEMINI_API_KEY=

# APP_URL: URL pública de la aplicación (usada en Render / producción).
APP_URL=

# SUPABASE: Credenciales de Supabase en el servidor para persistencia en PostgreSQL.
# Si no se configuran, el servidor utiliza persistencia local en disco para desarrollo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN_PASSCODE: Clave maestra de administrador para operaciones de escritura (crear, editar, eliminar).
# Si se deja vacío en el primer arranque, la interfaz permite reclamar una contraseña inicial de administrador.
ADMIN_PASSCODE=
